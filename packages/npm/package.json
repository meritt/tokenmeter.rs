{
  "name": "@meritt/tokenmeter-wasm",
  "version": "0.1.0",
  "description": "Counts the tokens of text in o200k_base with tiktoken's algorithm and splits it into token groups on grapheme boundaries, in WebAssembly",
  "keywords": [
    "gpt",
    "o200k_base",
    "openai",
    "tiktoken",
    "tokenizer",
    "tokens",
    "wasm",
    "webassembly"
  ],
  "license": "MIT",
  "author": {
    "name": "Alexey Simonenko",
    "email": "alexey@simonenko.dev",
    "url": "https://simonenko.xyz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meritt/tokenmeter.rs.git",
    "directory": "packages/npm"
  },
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "sideEffects": false,
  "exports": {
    ".": "./tokenmeter.js",
    "./tokenmeter.wasm": "./tokenmeter.wasm"
  },
  "files": [
    "tokenmeter.js",
    "tokenmeter.wasm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "error"
    }
  }
}
